# База данных
# PostgreSQL (продакшн)
DATABASE_URL=postgresql://username:password@localhost:5432/yartumba

# SQLite (тестовая, по умолчанию используется в тестах)
# DATABASE_URL=sqlite:///./test.db

# Окружение
ENV=DEV                     # DEV | PROD

# CORS — разрешённые источники (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQL-логирование (включать только для отладки)
SQL_ECHO=false

# Секреты (обязательно сменить в продакшне!)
SECRET_KEY=change-me-in-production
SESSION_SECRET=change-me-in-production
